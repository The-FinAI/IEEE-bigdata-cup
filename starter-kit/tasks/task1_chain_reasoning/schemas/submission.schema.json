{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finreason.example/schemas/task1/submission.schema.json",
  "title": "Task 1 submission record — organizer draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance_id", "final_answer", "reasoning_trace"],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "final_answer": {
      "type": ["string", "number", "boolean", "null"]
    },
    "reasoning_trace": {
      "type": ["array", "object", "string"]
    }
  },
  "$comment": "TODO: freeze answer normalization and the ChainEval-compatible reasoning trace schema."
}
