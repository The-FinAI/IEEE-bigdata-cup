# Safe local/default mode: URLs may remain empty and the pages show "not live yet".
FINREASON_TASK1_SITE_MODE=development

# Required for final mode: the organizer-verified Space used for submission and leaderboard.
# Never place a team access code, token, credential, or other secret in this public URL.
# Use only the root HTTPS URL of the verified *.hf.space deployment, without a query or fragment.
NEXT_PUBLIC_FINREASON_TASK1_HF_SPACE_URL=

# Optional extension: a CORS-enabled public aggregate development table.
NEXT_PUBLIC_FINREASON_TASK1_LEADERBOARD_API_URL=
