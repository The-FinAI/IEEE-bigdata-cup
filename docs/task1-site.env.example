# Safe local/default mode: URLs may remain empty and the pages show "not live yet".
# The value "final" means live Pages deployment state, not a competition phase.
FINREASON_TASK1_SITE_MODE=development

# Required together for final/live Pages mode: two isolated organizer-verified Spaces.
# Never place a team access code, token, credential, or other secret in either public URL.
# Use only distinct root HTTPS URLs of verified *.hf.space deployments.
NEXT_PUBLIC_FINREASON_TASK1_DEVELOPMENT_SPACE_URL=
NEXT_PUBLIC_FINREASON_TASK1_TEST_SPACE_URL=

# Optional extension: a CORS-enabled public aggregate development table.
NEXT_PUBLIC_FINREASON_TASK1_LEADERBOARD_API_URL=
