# Safe default: Space URLs may remain empty while the direct-upload service is being verified.
# The value "final" means the links are live; it does not mean test scores are public.
FINREASON_TASK1_SITE_MODE=development

# Required together for final/live Pages mode: two isolated organizer-verified Spaces.
# Never place a team code, token, credential, or other secret in a public URL.
NEXT_PUBLIC_FINREASON_TASK1_DEVELOPMENT_SPACE_URL=
NEXT_PUBLIC_FINREASON_TASK1_TEST_SPACE_URL=

# Optional CORS-enabled aggregate development leaderboard endpoint.
NEXT_PUBLIC_FINREASON_TASK1_LEADERBOARD_API_URL=
