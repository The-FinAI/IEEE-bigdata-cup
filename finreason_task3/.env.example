# Copy to `.env` and fill in. `.env` is git-ignored.

# Required for the official LLM judge (evaluation), and used by
# baselines/llm_api_template.py for OpenAI and any OpenAI-compatible provider.
OPENAI_API_KEY=

# Optional: point the API template at an OpenAI-compatible endpoint
# (DeepSeek, Qwen/DashScope, a local vLLM server, a gateway, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required only for baselines/claude_api_template.py
# ANTHROPIC_API_KEY=

# Optional: Hugging Face token for gated models used by baselines/hf_template.py
# HF_TOKEN=
