{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finreason.example/schemas/task3/submission.schema.json",
  "title": "Task 3 submission record — organizer draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "reported_value",
    "verified_value",
    "verification_status",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "reported_value": {
      "type": ["string", "number", "null"]
    },
    "verified_value": {
      "type": ["string", "number", "null"]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": ["array", "object", "string", "null"]
    }
  },
  "$comment": "TODO: freeze value, unit, status, and evidence semantics against a reviewed HERCULEAN-compatible case."
}
